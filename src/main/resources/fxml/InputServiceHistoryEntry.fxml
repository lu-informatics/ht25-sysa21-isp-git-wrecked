   maxWidth="-Infinity" 
   minHeight="-Infinity" 
   minWidth="-Infinity" 
   prefHeight="500.0" 
   prefWidth="400.0" 
   xmlns="http://javafx.com/javafx/25" 
   xmlns:fx="http://javafx.com/fxml/1" 
