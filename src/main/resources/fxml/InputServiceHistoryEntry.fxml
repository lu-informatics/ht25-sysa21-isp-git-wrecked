     <TextField fx:id="textFieldWorkshop" layoutX="100.0" layoutY="129.0" promptText="Workshop..." />
     <Button fx:id="buttonApply" layoutX="143.0" layoutY="219.0" mnemonicParsing="false" onAction="#handleButtonApplyAction" prefHeight="25.0" prefWidth="64.0" text="Apply" />
     <Label fx:id="labelResponse" layoutX="34.0" layoutY="24.0" prefHeight="17.0" prefWidth="289.0" />
